<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Organization Dashboard - Internship Portal</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #efefef;
      color: #1a1a1a;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 40px 20px;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 40px;
      padding-bottom: 20px;
      border-bottom: 2px solid #2a3f0f;
    }

    .header h1 {
      color: #2a3f0f;
      font-size: 32px;
    }

    .btn-primary {
      background-color: #2a3f0f;
      color: #efefef;
      padding: 12px 25px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-weight: 600;
    }

    .btn-primary:hover {
      background-color: #1e3410;
    }

    .internships-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      gap: 25px;
      margin-top: 30px;
    }

    .internship-card {
      background-color: white;
      padding: 25px;
      border-radius: 8px;
      border-left: 4px solid #2a3f0f;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .internship-card h3 {
      color: #2a3f0f;
      margin-bottom: 10px;
      font-size: 20px;
    }

    .internship-info {
      font-size: 14px;
      color: #666;
      margin: 8px 0;
      line-height: 1.6;
    }

    .app-count {
      background-color: #2a3f0f;
      color: #efefef;
      display: inline-block;
      padding: 5px 12px;
      border-radius: 20px;
      font-weight: 600;
      margin: 10px 0;
    }

    .action-buttons {
      display: flex;
      gap: 10px;
      margin-top: 15px;
    }

    .btn-small {
      flex: 1;
      padding: 10px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-weight: 600;
      font-size: 13px;
    }

    .btn-view {
      background-color: #2a3f0f;
      color: #efefef;
    }

    .btn-view:hover {
      background-color: #1e3410;
    }

    .btn-edit {
      background-color: #4a90a4;
      color: white;
    }

    .btn-edit:hover {
      background-color: #3a7a94;
    }

    .btn-delete {
      background-color: #c41e3a;
      color: white;
    }

    .btn-delete:hover {
      background-color: #a01a2f;
    }

    .empty-state {
      text-align: center;
      padding: 60px 20px;
      background-color: white;
      border-radius: 8px;
      margin-top: 30px;
    }

    .empty-state h2 {
      color: #2a3f0f;
      margin-bottom: 15px;
    }

    .empty-state p {
      color: #666;
      margin-bottom: 20px;
    }

    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.5);
      z-index: 1000;
    }

    .modal.active {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .modal-content {
      background-color: white;
      padding: 40px;
      border-radius: 8px;
      max-width: 600px;
      width: 90%;
      border-top: 4px solid #2a3f0f;
      max-height: 90vh;
      overflow-y: auto;
    }

    .close-modal {
      position: absolute;
      top: 20px;
      right: 20px;
      font-size: 28px;
      cursor: pointer;
      color: #666;
    }

    .form-group {
      margin-bottom: 15px;
    }

    label {
      display: block;
      font-weight: 600;
      margin-bottom: 5px;
    }

    input,
    textarea {
      width: 100%;
      padding: 10px;
      border: 1px solid #e8e8e8;
      border-radius: 5px;
      font-family: inherit;
    }

    input:focus,
    textarea:focus {
      outline: none;
      border-color: #2a3f0f;
    }

    .btn-submit {
      width: 100%;
      padding: 12px;
      background-color: #2a3f0f;
      color: #efefef;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-weight: 600;
      margin-top: 20px;
    }

    /* ========== APPLICATIONS MODAL STYLES ========== */
    .application-item {
      background: #f9f9f9;
      padding: 15px;
      margin-bottom: 15px;
      border-radius: 5px;
      border-left: 3px solid #c41e3a;
    }

    .app-student-info {
      font-weight: bold;
      color: #2a3f0f;
      margin-bottom: 8px;
      font-size: 16px;
    }

    .app-email {
      font-size: 12px;
      color: #666;
      margin: 3px 0;
    }

    .app-program {
      font-size: 12px;
      color: #666;
      margin: 3px 0;
    }

    .app-cover-letter {
      background: white;
      padding: 10px;
      border-radius: 3px;
      margin: 10px 0;
      font-size: 13px;
      color: #333;
      border-left: 2px solid #2a3f0f;
      font-style: italic;
    }

    .app-status {
      display: inline-block;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
      margin: 10px 0;
    }

    .status-pending {
      background-color: #fff3cd;
      color: #856404;
    }

    .status-accepted {
      background-color: #d4edda;
      color: #155724;
    }

    .status-rejected {
      background-color: #f8d7da;
      color: #721c24;
    }

    .app-buttons {
      margin-top: 10px;
    }

    .action-btn {
      padding: 8px 15px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-weight: 600;
      margin: 5px 5px 5px 0;
      font-size: 12px;
    }

    .accept-btn {
      background-color: #28a745;
      color: white;
    }

    .accept-btn:hover {
      background-color: #218838;
    }

    .reject-btn {
      background-color: #dc3545;
      color: white;
    }

    .reject-btn:hover {
      background-color: #c82333;
    }

    .no-apps {
      text-align: center;
      color: #999;
      padding: 20px;
    }

    .footer {
      background-color: #2a3f0f;
      color: #efefef;
      text-align: center;
      padding: 20px;
      margin-top: auto;
    }
  </style>
</head>

<body>
  <%- include('../layouts/navbar') %>

    <div class="container">
      <div class="header">
        <h1>Organization Dashboard</h1>
        <button class="btn-primary" onclick="openPostModal()">+ Post New Internship</button>
      </div>

      <div id="internshipsList">
        <p>Loading internships...</p>
      </div>
    </div>

    <!-- Post Internship Modal -->
    <div class="modal" id="postModal">
      <div class="modal-content">
        <span class="close-modal" onclick="closePostModal()">&times;</span>
        <h2 style="color: #2a3f0f; margin-bottom: 20px;">Post New Internship</h2>

        <form id="postForm">
          <div class="form-group">
            <label>Internship Title</label>
            <input type="text" name="title" required placeholder="e.g. Backend Developer Intern">
          </div>

          <div class="form-group">
            <label>Description</label>
            <textarea name="description" rows="4" required
              placeholder="Describe the role and responsibilities..."></textarea>
          </div>

          <div class="form-group">
            <label>Requirements</label>
            <textarea name="requirements" rows="3" placeholder="Skills and qualifications needed..."></textarea>
          </div>

          <div class="form-group">
            <label>Location</label>
            <input type="text" name="location" required placeholder="e.g. Lagos, Nigeria">
          </div>

          <div class="form-group">
            <label>Duration</label>
            <input type="text" name="duration" placeholder="e.g. 3 months">
          </div>

          <div class="form-group">
            <label>Stipend/Compensation</label>
            <input type="text" name="stipend" placeholder="e.g. ₦50,000/month">
          </div>

          <button type="submit" class="btn-submit">Post Internship</button>
          <div id="postMessage"></div>
        </form>
      </div>
    </div>

    <div class="modal" id="applicationsModal">
      <div class="modal-content">
        <span class="close-modal" onclick="closeApplicationsModal()">&times;</span>
        <h2 id="modalTitle" style="color: #2a3f0f; margin-bottom: 20px;">Applications</h2>
        <div id="applicationsListContainer">
          <p>Loading applications...</p>
        </div>
      </div>
    </div>

    <%- include('../layouts/footer') %>

      <script>
        // const token = localStorage.getItem('token');
        // const user = JSON.parse(localStorage.getItem('user') || '{}');

        if (!token || user.role !== 'organisation') {
          window.location.href = '/auth/login';
        }

        async function loadInternships() {
          try {
            const response = await fetch('/api/internship/org', {
              headers: { 'Authorization': `Bearer ${token}` }
            });

            const data = await response.json();
            const container = document.getElementById('internshipsList');

            if (!data.internships || data.internships.length === 0) {
              container.innerHTML = `
            <div class="empty-state">
              <h2>No internships posted yet</h2>
              <p>Start by posting your first internship opportunity</p>
              <button class="btn-primary" onclick="openPostModal()">+ Post Internship</button>
            </div>
          `;
              return;
            }

            container.innerHTML = `<div class="internships-grid">
          ${data.internships.map(internship => `
            <div class="internship-card">
              <h3>${internship.title}</h3>
              <div class="internship-info"><strong>Location:</strong> ${internship.location}</div>
              <div class="app-count">${internship.application_count || 0} Applications</div>
              <div class="internship-info">${internship.description.substring(0, 100)}...</div>
              <div class="action-buttons">
                <button class="btn-small btn-view" onclick="viewApplications(${internship.id}, '${internship.title.replace(/'/g, "\\'")}')">View Applications</button>
                <button class="btn-small btn-edit">Edit</button>
                <button class="btn-small btn-delete" onclick="deleteInternship(${internship.id})">Delete</button>
              </div>
            </div>
          `).join('')}
        </div>`;

          } catch (err) {
            console.error(err);
            document.getElementById('internshipsList').innerHTML = '<p style="color: red;">Error loading internships</p>';
          }
        }

        function openPostModal() {
          document.getElementById('postModal').classList.add('active');
        }

        function closePostModal() {
          document.getElementById('postModal').classList.remove('active');
          document.getElementById('postForm').reset();
        }

        function closeApplicationsModal() {
          document.getElementById('applicationsModal').classList.remove('active');
        }

        document.getElementById('postForm').addEventListener('submit', async (e) => {
          e.preventDefault();

          const formData = new FormData(e.target);
          const data = Object.fromEntries(formData);

          try {
            const response = await fetch('/api/internship/create', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
              },
              body: JSON.stringify(data)
            });

            const result = await response.json();
            const messageDiv = document.getElementById('postMessage');

            if (response.ok) {
              messageDiv.style.color = '#155724';
              messageDiv.style.backgroundColor = '#d4edda';
              messageDiv.style.padding = '10px';
              messageDiv.style.borderRadius = '5px';
              messageDiv.style.marginTop = '15px';
              messageDiv.textContent = result.message || 'Internship posted successfully!';

              setTimeout(() => {
                closePostModal();
                loadInternships();
              }, 1500);
            } else {
              messageDiv.style.color = '#721c24';
              messageDiv.style.backgroundColor = '#f8d7da';
              messageDiv.style.padding = '10px';
              messageDiv.style.borderRadius = '5px';
              messageDiv.style.marginTop = '15px';
              messageDiv.textContent = result.error || 'Failed to post internship';
            }
          } catch (err) {
            document.getElementById('postMessage').textContent = 'Error connecting to server';
          }
        });

        async function viewApplications(internshipId, internshipTitle) {
          try {
            currentInternshipId = internshipId;
            document.getElementById('modalTitle').textContent = `Applications for: ${internshipTitle}`;

            const response = await fetch('/api/internship/org', {
              headers: { 'Authorization': `Bearer ${token}` }
            });

            const data = await response.json();

            // Filter applications for this internship
            const filtered = data.applications.filter(app => app.internship_id === internshipId);

            const container = document.getElementById('applicationsListContainer');

            if (!filtered || filtered.length === 0) {
              container.innerHTML = '<div class="no-apps">No applications for this internship yet</div>';
              document.getElementById('applicationsModal').classList.add('active');
              return;
            }

            let html = '';
            filtered.forEach(app => {
              const statusClass = `status-${app.status}`;
              const coverLetter = app.cover_letter || 'No cover letter provided';

              html += `
            <div class="application-item">
              <div class="app-student-info">${app.full_name}</div>
              <div class="app-email">📧 ${app.student_email}</div>
              <div class="app-program">📚 ${app.program || 'N/A'}</div>

              <span class="app-status ${statusClass}">${app.status.toUpperCase()}</span>

              <div class="app-cover-letter">
                <strong>Cover Letter:</strong><br>
                ${coverLetter}
              </div>

              ${app.status === 'pending' ? `
                <div class="app-buttons">
                  <button class="action-btn accept-btn" onclick="updateStatus(${app.id}, 'accepted')"> Accept</button>
                  <button class="action-btn reject-btn" onclick="updateStatus(${app.id}, 'rejected')"> Reject</button>
                </div>
              ` : `
                <div style="color: #999; font-size: 12px; margin-top: 10px;">Already ${app.status}</div>
              `}
            </div>
          `;
            });

            container.innerHTML = html;
            document.getElementById('applicationsModal').classList.add('active');

          } catch (err) {
            console.error(err);
            document.getElementById('applicationsListContainer').innerHTML = '<p style="color: red;">Error loading applications</p>';
          }
        }

        async function updateStatus(applicationId, newStatus) {
          try {
            const response = await fetch('/api/application/update-status', {
              method: 'PUT',
              headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
              },
              body: JSON.stringify({
                application_id: applicationId,
                status: newStatus
              })
            });

            if (response.ok) {
              alert(`✅ Application ${newStatus}!`);
              viewApplications(currentInternshipId, document.getElementById('modalTitle').textContent.replace('Applications for: ', ''));
            } else {
              alert('❌ Error updating status');
            }
          } catch (err) {
            alert('❌ Error updating status');
          }
        }

        async function deleteInternship(internshipId) {
          if (!confirm('Are you sure you want to delete this internship?')) {
            return;
          }

          try {
            const response = await fetch(`/api/internship/delete/${internshipId}`, {
              method: 'DELETE',
              headers: {
                'Authorization': `Bearer ${token}`
              }
            });

            const result = await response.json();

            if (response.ok) {
              alert(result.message || 'Internship deleted successfully!');
              loadInternships();
            } else {
              alert(result.error || 'Failed to delete internship');
            }

          } catch (error) {
            console.error(error);
            alert('Error connecting to server');
          }
        }

        // Close modal when clicking outside
        document.getElementById('postModal').addEventListener('click', (e) => {
          if (e.target.id === 'postModal') closePostModal();
        });

        document.getElementById('applicationsModal').addEventListener('click', (e) => {
          if (e.target.id === 'applicationsModal') closeApplicationsModal();
        });

        loadInternships();
      </script>
</body>

</html>