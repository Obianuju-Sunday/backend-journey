<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Organization Dashboard - Internship Portal</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #FFFDD0;
      color: #1a1a1a;
    }
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 40px 20px;
    }
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 40px;
      padding-bottom: 20px;
      border-bottom: 2px solid #2D5016;
    }
    .header h1 {
      color: #2D5016;
      font-size: 32px;
    }
    .btn-primary {
      background-color: #2D5016;
      color: #FFFDD0;
      padding: 12px 25px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-weight: 600;
    }
    .btn-primary:hover {
      background-color: #1e3410;
    }
    .internships-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      gap: 25px;
      margin-top: 30px;
    }
    .internship-card {
      background-color: white;
      padding: 25px;
      border-radius: 8px;
      border-left: 4px solid #2D5016;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .internship-card h3 {
      color: #2D5016;
      margin-bottom: 10px;
      font-size: 20px;
    }
    .internship-info {
      font-size: 14px;
      color: #666;
      margin: 8px 0;
      line-height: 1.6;
    }
    .app-count {
      background-color: #2D5016;
      color: #FFFDD0;
      display: inline-block;
      padding: 5px 12px;
      border-radius: 20px;
      font-weight: 600;
      margin: 10px 0;
    }
    .action-buttons {
      display: flex;
      gap: 10px;
      margin-top: 15px;
    }
    .btn-small {
      flex: 1;
      padding: 10px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-weight: 600;
      font-size: 13px;
    }
    .btn-view {
      background-color: #2D5016;
      color: #FFFDD0;
    }
    .btn-view:hover {
      background-color: #1e3410;
    }
    .btn-edit {
      background-color: #4a90a4;
      color: white;
    }
    .btn-edit:hover {
      background-color: #3a7a94;
    }
    .btn-delete {
      background-color: #c41e3a;
      color: white;
    }
    .btn-delete:hover {
      background-color: #a01a2f;
    }
    .empty-state {
      text-align: center;
      padding: 60px 20px;
      background-color: white;
      border-radius: 8px;
      margin-top: 30px;
    }
    .empty-state h2 {
      color: #2D5016;
      margin-bottom: 15px;
    }
    .empty-state p {
      color: #666;
      margin-bottom: 20px;
    }
    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.5);
      z-index: 1000;
    }
    .modal.active {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .modal-content {
      background-color: white;
      padding: 40px;
      border-radius: 8px;
      max-width: 600px;
      width: 90%;
      border-top: 4px solid #2D5016;
      max-height: 90vh;
      overflow-y: auto;
    }
    .close-modal {
      position: absolute;
      top: 20px;
      right: 20px;
      font-size: 28px;
      cursor: pointer;
      color: #666;
    }
    .form-group {
      margin-bottom: 15px;
    }
    label {
      display: block;
      font-weight: 600;
      margin-bottom: 5px;
    }
    input, textarea {
      width: 100%;
      padding: 10px;
      border: 1px solid #e8e8e8;
      border-radius: 5px;
      font-family: inherit;
    }
    input:focus, textarea:focus {
      outline: none;
      border-color: #2D5016;
    }
    .btn-submit {
      width: 100%;
      padding: 12px;
      background-color: #2D5016;
      color: #FFFDD0;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-weight: 600;
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <%- include('../layouts/navbar') %>
  
  <div class="container">
    <div class="header">
      <h1>Organization Dashboard</h1>
      <button class="btn-primary" onclick="openPostModal()">+ Post New Internship</button>
    </div>
    
    <div id="internshipsList">
      <p>Loading internships...</p>
    </div>
  </div>
  
  <!-- Post Internship Modal -->
  <div class="modal" id="postModal">
    <div class="modal-content">
      <span class="close-modal" onclick="closePostModal()">&times;</span>
      <h2 style="color: #2D5016; margin-bottom: 20px;">Post New Internship</h2>
      
      <form id="postForm">
        <div class="form-group">
          <label>Internship Title</label>
          <input type="text" name="title" required placeholder="e.g. Backend Developer Intern">
        </div>
        
        <div class="form-group">
          <label>Description</label>
          <textarea name="description" rows="4" required placeholder="Describe the role and responsibilities..."></textarea>
        </div>
        
        <div class="form-group">
          <label>Requirements</label>
          <textarea name="requirements" rows="3" placeholder="Skills and qualifications needed..."></textarea>
        </div>
        
        <div class="form-group">
          <label>Location</label>
          <input type="text" name="location" required placeholder="e.g. Lagos, Nigeria">
        </div>
        
        <div class="form-group">
          <label>Duration</label>
          <input type="text" name="duration" placeholder="e.g. 3 months">
        </div>
        
        <div class="form-group">
          <label>Stipend/Compensation</label>
          <input type="text" name="stipend" placeholder="e.g. ₦50,000/month">
        </div>
        
        <button type="submit" class="btn-submit">Post Internship</button>
        <div id="postMessage"></div>
      </form>
    </div>
  </div>
  
  <%- include('../layouts/footer') %>
  
  <script>
    const token = localStorage.getItem('token');
    const user = JSON.parse(localStorage.getItem('user') || '{}');
    
    if (!token || user.role !== 'organisation') {
      window.location.href = '/auth/login';
    }
    
    async function loadInternships() {
      try {
        const response = await fetch('/api/internship/org', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        
        const data = await response.json();
        const container = document.getElementById('internshipsList');
        
        if (!data.internships || data.internships.length === 0) {
          container.innerHTML = `
            <div class="empty-state">
              <h2>No internships posted yet</h2>
              <p>Start by posting your first internship opportunity</p>
              <button class="btn-primary" onclick="openPostModal()">+ Post Internship</button>
            </div>
          `;
          return;
        }
        
        container.innerHTML = `<div class="internships-grid">
          ${data.internships.map(internship => `
            <div class="internship-card">
              <h3>${internship.title}</h3>
              <div class="internship-info"><strong>Location:</strong> ${internship.location}</div>
              <div class="app-count">${internship.application_count || 0} Applications</div>
              <div class="internship-info">${internship.description.substring(0, 100)}...</div>
              <div class="action-buttons">
                <button class="btn-small btn-view" onclick="viewApplications(${internship.id})">View Apps</button>
                <button class="btn-small btn-edit">Edit</button>
                <button class="btn-small btn-delete" onclick="deleteInternship(${internship.id})">Delete</button>
              </div>
            </div>
          `).join('')}
        </div>`;
        
      } catch (err) {
        console.error(err);
        document.getElementById('internshipsList').innerHTML = '<p style="color: red;">Error loading internships</p>';
      }
    }
    
    function openPostModal() {
      document.getElementById('postModal').classList.add('active');
    }
    
    function closePostModal() {
      document.getElementById('postModal').classList.remove('active');
      document.getElementById('postForm').reset();
    }
    
    document.getElementById('postForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData);
      
      try {
        const response = await fetch('/api/internship/create', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify(data)
        });
        
        const result = await response.json();
        const messageDiv = document.getElementById('postMessage');
        
        if (response.ok) {
          messageDiv.style.color = '#155724';
          messageDiv.style.backgroundColor = '#d4edda';
          messageDiv.style.padding = '10px';
          messageDiv.style.borderRadius = '5px';
          messageDiv.style.marginTop = '15px';
          messageDiv.textContent = result.message || 'Internship posted successfully!';
          
          setTimeout(() => {
            closePostModal();
            loadInternships();
          }, 1500);
        } else {
          messageDiv.style.color = '#721c24';
          messageDiv.style.backgroundColor = '#f8d7da';
          messageDiv.style.padding = '10px';
          messageDiv.style.borderRadius = '5px';
          messageDiv.style.marginTop = '15px';
          messageDiv.textContent = result.error || 'Failed to post internship';
        }
      } catch (err) {
        document.getElementById('postMessage').textContent = 'Error connecting to server';
      }
    });
    
    function viewApplications(internshipId) {
      alert('Applications page - coming soon! Internship ID: ' + internshipId);
    }
    
    function deleteInternship(internshipId) {
      if (confirm('Are you sure you want to delete this internship?')) {
        alert('Delete functionality - coming soon!');
      }
    }
    
    loadInternships();
  </script>
</body>
</html>