<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Organization Profile - Internship Portal</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #efefef;
      color: #1a1a1a;
    }
    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 40px 20px;
    }
    h1 {
      color: #2a3f0f;
      margin-bottom: 30px;
      font-size: 32px;
    }
    .profile-card {
      background-color: white;
      padding: 40px;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      border-top: 4px solid #2a3f0f;
      margin-bottom: 30px;
    }
    .profile-info {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      margin-bottom: 30px;
    }
    .info-item {
      padding: 15px;
      background-color: #f9f9f9;
      border-radius: 5px;
      border-left: 3px solid #2a3f0f;
    }
    .info-item label {
      font-weight: 600;
      color: #2a3f0f;
      display: block;
      margin-bottom: 5px;
    }
    .info-item span {
      color: #666;
    }
    .edit-btn {
      background-color: #2a3f0f;
      color: #efefef;
      padding: 12px 25px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-weight: 600;
    }
    .edit-btn:hover {
      background-color: #1e3410;
    }
    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.5);
      z-index: 1000;
    }
    .modal.active {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .modal-content {
      background-color: white;
      padding: 40px;
      border-radius: 8px;
      max-width: 500px;
      width: 90%;
      border-top: 4px solid #2a3f0f;
    }
    .close-modal {
      position: absolute;
      top: 20px;
      right: 20px;
      font-size: 28px;
      cursor: pointer;
      color: #666;
    }
    .form-group {
      margin-bottom: 15px;
    }
    label {
      display: block;
      font-weight: 600;
      margin-bottom: 5px;
    }
    input, textarea {
      width: 100%;
      padding: 10px;
      border: 1px solid #e8e8e8;
      border-radius: 5px;
      font-family: inherit;
    }
    input:focus, textarea:focus {
      outline: none;
      border-color: #2a3f0f;
    }
    .btn-group {
      display: flex;
      gap: 10px;
      margin-top: 20px;
    }
    .btn {
      flex: 1;
      padding: 12px;
      border: none;
      border-radius: 5px;
      font-weight: 600;
      cursor: pointer;
    }
    .btn-submit {
      background-color: #2a3f0f; 
      color: #efefef;
    }
    .btn-cancel {
      background-color: #e8e8e8;
      color: #1a1a1a;
    }
    .message {
      margin-top: 15px;
      padding: 10px;
      border-radius: 5px;
      text-align: center;
    }
    .success {
      background-color: #d4edda;
      color: #155724;
    }
    .error {
      background-color: #f8d7da;
      color: #721c24;
    }
  </style>
</head>
<body>
  <%- include('../layouts/navbar') %>
  
  <div class="container">
    <h1>Organization Profile</h1>
    
    <div class="profile-card">
      <div class="profile-info" id="profileInfo">
        <p>Loading profile...</p>
      </div>
      <button class="edit-btn" onclick="openEditModal()">Edit Profile</button>
    </div>
  </div>
  
  <!-- Edit Profile Modal -->
  <div class="modal" id="editModal">
    <div class="modal-content">
      <span class="close-modal" onclick="closeEditModal()">&times;</span>
      <h2 style="color: #2a3f0f; margin-bottom: 20px;">Edit Organization Profile</h2>
      
      <form id="editForm">
        <div class="form-group">
          <label>Company Name</label>
          <input type="text" id="editCompanyName" name="company_name">
        </div>
        
        <div class="form-group">
          <label>Industry</label>
          <input type="text" id="editIndustry" name="industry">
        </div>
        
        <div class="form-group">
          <label>Website</label>
          <input type="url" id="editWebsite" name="website" placeholder="https://...">
        </div>
        
        <div class="form-group">
          <label>Location</label>
          <input type="text" id="editLocation" name="location">
        </div>
        
        <div class="form-group">
          <label>Description</label>
          <textarea id="editDescription" name="description" rows="4" placeholder="Tell us about your organization..."></textarea>
        </div>
        
        <div class="btn-group">
          <button type="submit" class="btn btn-submit">Save Changes</button>
          <button type="button" class="btn btn-cancel" onclick="closeEditModal()">Cancel</button>
        </div>
        <div id="editMessage"></div>
      </form>
    </div>
  </div>
  
  <%- include('../layouts/footer') %>
  
  <script>
    // const token = localStorage.getItem('token');
    // const user = JSON.parse(localStorage.getItem('user') || '{}');
    
    if (!token || user.role !== 'organisation') {
      window.location.href = '/auth/login';
    }
    
    async function loadProfile() {
      try {
        const response = await fetch('/api/users/organisation/profile', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        
        const data = await response.json();
        const container = document.getElementById('profileInfo');
        
        if (response.ok) {
          const profile = data;
          container.innerHTML = `
            <div class="info-item">
              <label>Company Name</label>
              <span>${profile.company_name || 'Not set'}</span>
            </div>
            <div class="info-item">
              <label>Email</label>
              <span>${user.email}</span>
            </div>
            <div class="info-item">
              <label>Industry</label>
              <span>${profile.industry || 'Not set'}</span>
            </div>
            <div class="info-item">
              <label>Location</label>
              <span>${profile.location || 'Not set'}</span>
            </div>
            <div class="info-item" style="grid-column: 1 / -1;">
              <label>Website</label>
              <span>${profile.website ? `<a href="${profile.website}" target="_blank">${profile.website}</a>` : 'Not set'}</span>
            </div>
            <div class="info-item" style="grid-column: 1 / -1;">
              <label>Description</label>
              <span>${profile.description || 'Not set'}</span>
            </div>
          `;
          
          // Fill edit form
          document.getElementById('editCompanyName').value = profile.company_name || '';
          document.getElementById('editIndustry').value = profile.industry || '';
          document.getElementById('editWebsite').value = profile.website || '';
          document.getElementById('editLocation').value = profile.location || '';
          document.getElementById('editDescription').value = profile.description || '';
        } else {
          container.innerHTML = '<p style="color: red;">Error loading profile</p>';
        }
      } catch (err) {
        console.error(err);
        document.getElementById('profileInfo').innerHTML = '<p style="color: red;">Error loading profile</p>';
      }
    }
    
    function openEditModal() {
      document.getElementById('editModal').classList.add('active');
    }
    
    function closeEditModal() {
      document.getElementById('editModal').classList.remove('active');
      document.getElementById('editMessage').innerHTML = '';
    }
    
    document.getElementById('editForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData);
      
      try {
        const response = await fetch('/api/users/organisation/profile', {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify(data)
        });
        
        const result = await response.json();
        const messageDiv = document.getElementById('editMessage');
        
        if (response.ok) {
          messageDiv.className = 'message success';
          messageDiv.textContent = 'Profile updated successfully!';
          setTimeout(() => {
            closeEditModal();
            loadProfile();
          }, 1500);
        } else {
          messageDiv.className = 'message error';
          messageDiv.textContent = result.error || 'Failed to update profile';
        }
      } catch (err) {
        document.getElementById('editMessage').className = 'message error';
        document.getElementById('editMessage').textContent = 'Error updating profile';
      }
    });
    
    loadProfile();
  </script>
</body>
</html>