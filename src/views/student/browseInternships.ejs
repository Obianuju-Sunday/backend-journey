<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Browse Internships - Beacon</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html,
    body {
      height: 100%;
      display: flex;
      flex-direction: column;
      font-family: Arial;
      background-color: #efefef;
      color: #000000;
    }

    .navbar {
      background-color: #2a3f0f;
      padding: 20px 50px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .navbar a {
      color: #efefef;
      text-decoration: none;
      margin: 0 15px;
      font-weight: bold;
    }

    .navbar button {
      background-color: #c41e3a;
      color: white;
      border: none;
      padding: 10px 20px;
      cursor: pointer;
      border-radius: 5px;
    }

    .welcome {
      background-color: #2a3f0f;
      color: #efefef;
      padding: 20px 50px;
      border-bottom: 3px solid #c41e3a;
    }

    .welcome h2 {
      margin: 0;
      font-size: 28px;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 40px 20px;
      flex: 1;
    }

    h1 {
      color: #2a3f0f;
      margin-bottom: 30px;
    }

    .internships-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 20px;
    }

    .internship-card {
      background: white;
      padding: 20px;
      border-left: 4px solid #2a3f0f;
      border-radius: 5px;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    .internship-card h3 {
      color: #2a3f0f;
      margin-bottom: 10px;
    }

    .internship-card p {
      margin: 5px 0;
      color: #666;
      font-size: 14px;
    }

    .apply-btn {
      background-color: #2a3f0f;
      color: #efefef;
      padding: 10px 20px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      margin-top: 15px;
      width: 100%;
      font-weight: bold;
      transition: background-color 0.3s;
    }

    .apply-btn:hover {
      background-color: #1a2f0a;
    }

    /* ========== MODAL STYLES ========== */
    .modal {
      display: none;
      position: fixed;
      z-index: 1000;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.5);
    }

    .modal.active {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .modal-content {
      background-color: white;
      padding: 30px;
      border-radius: 10px;
      max-width: 500px;
      width: 90%;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    }

    .modal-header {
      margin-bottom: 20px;
    }

    .modal-header h2 {
      color: #2a3f0f;
      margin: 0 0 10px 0;
    }

    .modal-header p {
      color: #666;
      margin: 0;
      font-size: 14px;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-group label {
      display: block;
      color: #2a3f0f;
      font-weight: bold;
      margin-bottom: 8px;
    }

    .form-group textarea {
      width: 100%;
      padding: 12px;
      border: 2px solid #2a3f0f;
      border-radius: 5px;
      font-family: Arial;
      font-size: 14px;
      resize: vertical;
      min-height: 120px;
    }

    .form-group textarea:focus {
      outline: none;
      border-color: #c41e3a;
    }

    .modal-buttons {
      display: flex;
      gap: 10px;
      justify-content: flex-end;
    }

    .btn {
      padding: 12px 25px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-weight: bold;
      font-size: 14px;
      transition: background-color 0.3s;
    }

    .btn-submit {
      background-color: #2a3f0f;
      color: white;
    }

    .btn-submit:hover {
      background-color: #1a2f0a;
    }

    .btn-cancel {
      background-color: #ccc;
      color: #000;
    }

    .btn-cancel:hover {
      background-color: #bbb;
    }

    .footer {
      background-color: #2a3f0f;
      color: #efefef;
      text-align: center;
      padding: 20px;
      margin-top: auto;
    }
  </style>
</head>

<body>
  <!-- NAVBAR -->
  <%- include('../layouts/navbar') %>

    <!-- MAIN CONTENT -->
    <div class="container">
      <h1>Available Internships</h1>

      <!-- INTERNSHIPS GRID -->
      <div class="internships-grid" id="internshipsList">
        <p>Loading internships...</p>
      </div>
    </div>

    <!-- APPLY MODAL -->
    <div id="applyModal" class="modal">
      <div class="modal-content">
        <div class="modal-header">
          <h2>Apply to Internship</h2>
          <p id="modalInternshipTitle">Title will show here</p>
        </div>

        <form id="applicationForm">
          <div class="form-group">
            <label for="coverLetter">Cover Letter (Optional)</label>
            <textarea id="coverLetter" placeholder="Tell us why you're a great fit for this opportunity..."></textarea>
          </div>

          <div class="modal-buttons">
            <button type="button" class="btn btn-cancel" onclick="closeModal()">Cancel</button>
            <button type="submit" class="btn btn-submit">Submit Application</button>
          </div>
        </form>
      </div>
    </div>

    <!-- FOOTER -->
    <%- include('../layouts/footer') %>

      <script>
        // ========== GET USER DATA ==========
        // const token = localStorage.getItem('token');
        // const user = JSON.parse(localStorage.getItem('user') || '{}');

        if (!token || user.role !== 'student') {
          window.location.href = '/auth/login';
        }

        // Show welcome name
        // if (user.full_name) {
        //   document.getElementById('welcomeName').textContent = user.full_name;
        // }

        // ========== MODAL VARIABLES ==========
        let currentInternshipId = null;

        // ========== LOAD INTERNSHIPS ==========
        async function loadInternships() {
          try {
            // ========== FETCH INTERNSHIPS ==========
            const response = await fetch('/api/internship/all');
            const data = await response.json();

            // ========== FETCH USER'S APPLICATIONS ==========
            const appResponse = await fetch('/api/application/my-applications', {
              headers: { 'Authorization': `Bearer ${token}` }
            });
            const appData = await appResponse.json();
            const appliedInternshipIds = appData.applications ? appData.applications.map(app => app.internship_id) : [];

            const container = document.getElementById('internshipsList');

            if (!data.internships || data.internships.length === 0) {
              container.innerHTML = '<p>No internships available</p>';
              return;
            }

            container.innerHTML = data.internships.map(internship => {
              const alreadyApplied = appliedInternshipIds.includes(internship.id);

              return `
        <div class="internship-card">
          <h3>${internship.title}</h3>
          <p><strong>Company:</strong> ${internship.company_name}</p>
          <p><strong>Location:</strong> ${internship.location}</p>
          <p><strong>Duration:</strong> ${internship.duration || 'N/A'}</p>
          <p><strong>Stipend:</strong> ${internship.stipend || 'N/A'}</p>
          <p>${internship.description.substring(0, 100)}...</p>
          
          ${alreadyApplied ? `
            <button class="apply-btn" style="background-color: #6c757d; cursor: not-allowed;" disabled>
              ✓ Already Applied
            </button>
          ` : `
            <button class="apply-btn" onclick="openModal(${internship.id}, '${internship.title}')">
              Apply Now
            </button>
          `}
        </div>
      `;
            }).join('');

          } catch (err) {
            console.error('Error:', err);
            document.getElementById('internshipsList').innerHTML = '<p style="color: red;">Error loading internships</p>';
          }
        }

        // ========== MODAL FUNCTIONS ==========
        function openModal(internshipId, title) {
          currentInternshipId = internshipId;
          document.getElementById('modalInternshipTitle').textContent = title;
          document.getElementById('coverLetter').value = '';
          document.getElementById('applyModal').classList.add('active');
        }

        function closeModal() {
          document.getElementById('applyModal').classList.remove('active');
          currentInternshipId = null;
        }

        // ========== SUBMIT APPLICATION ==========
        document.getElementById('applicationForm').addEventListener('submit', async (e) => {
          e.preventDefault();

          const coverLetter = document.getElementById('coverLetter').value;

          try {
            const response = await fetch('/api/application/apply', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
              },
              body: JSON.stringify({
                internship_id: currentInternshipId,
                cover_letter: coverLetter || ''
              })
            });

            const data = await response.json();

            if (response.ok) {
              alert('✅ Application submitted successfully!');
              closeModal();
              loadInternships(); 
            } else {
              alert(`⚠️ ${data.error || 'Error submitting application'}`);
            }
          } catch (err) {
            console.error(err);
            alert('❌ Error submitting application');
          }
        });

        // ========== CLOSE MODAL ON OUTSIDE CLICK ==========
        document.getElementById('applyModal').addEventListener('click', (e) => {
          if (e.target.id === 'applyModal') {
            closeModal();
          }
        });

        // ========== LOAD PAGE ==========
        loadInternships();
      </script>
</body>

</html>