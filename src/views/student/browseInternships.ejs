<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Browse Internships</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial;
      background-color: #efefef;
      color: #000000;
    }

    .navbar {
      background-color: #2a3f0f;
      padding: 20px 50px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .navbar a {
      color: #efefef;
      text-decoration: none;
      margin: 0 15px;
      font-weight: bold;
    }

    .navbar button {
      background-color: #c41e3a;
      color: white;
      border: none;
      padding: 10px 20px;
      cursor: pointer;
      border-radius: 5px;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 40px 20px;
    }

    h1 {
      color: #2a3f0f;
      margin-bottom: 30px;
    }

    .internships-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 20px;
    }

    .internship-card {
      background: white;
      padding: 20px;
      border-left: 4px solid #2a3f0f;
      border-radius: 5px;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    .internship-card h3 {
      color: #2a3f0f;
      margin-bottom: 10px;
    }

    .internship-card p {
      margin: 5px 0;
      color: #666;
    }

    .apply-btn {
      background-color: #2a3f0f;
      color: #efefef;
      padding: 10px 20px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      margin-top: 15px;
      width: 100%;
      font-weight: bold;
    }

    .apply-btn:hover {
      background-color: #1a2f0a;
    }

    .footer {
      background-color: #2a3f0f;
      color: #efefef;
      text-align: center;
      padding: 20px;
      margin-top: 50px;
    }
  </style>
</head>

<body>
  <!-- NAVBAR -->
  <%- include('../layouts/navbar') %>

  <!-- MAIN CONTENT -->
  <div class="container">
    <h1>Browse Internship Opportunities</h1>

    <!-- INTERNSHIPS WILL LOAD HERE -->
    <div class="internships-grid" id="internshipsList">
      <p>Loading internships...</p>
    </div>
  </div>

  <!-- FOOTER -->
  <%- include('../layouts/footer') %>

  <script>
    // ========== STEP 1: CHECK IF USER IS LOGGED IN ==========
    // const token = localStorage.getItem('token');
    // const user = JSON.parse(localStorage.getItem('user') || '{}');

    if (!token || user.role !== 'student') {
      window.location.href = '/auth/login';
    }

    // ========== STEP 2: FETCH INTERNSHIPS FROM API ==========
    async function loadInternships() {
      try {
        // Call backend API to get internships
        const response = await fetch('/api/internship/all');
        const data = await response.json();

        const container = document.getElementById('internshipsList');

        if (!data.internships || data.internships.length === 0) {
          container.innerHTML = '<p>No internships available</p>';
          return;
        }

        // Build HTML for each internship
        container.innerHTML = data.internships.map(internship => `
          <div class="internship-card">
            <h3>${internship.title}</h3>
            <p><strong>Company:</strong> ${internship.company_name}</p>
            <p><strong>Location:</strong> ${internship.location}</p>
            <p><strong>Duration:</strong> ${internship.duration}</p>
            <p><strong>Stipend:</strong> ${internship.stipend}</p>
            <p>${internship.description.substring(0, 100)}...</p>
            <button class="apply-btn" onclick="applyNow(${internship.id}, '${internship.title}')">Apply Now</button>
          </div>
        `).join('');

      } catch (err) {
        console.error('Error:', err);
        document.getElementById('internshipsList').innerHTML = '<p style="color: red;">Error loading internships</p>';
      }
    }

    // ========== STEP 3: APPLY TO INTERNSHIP ==========
    function applyNow(internshipId, title) {
      const coverLetter = prompt(`Apply to: ${title}\n\nEnter cover letter (or leave blank):`);

      if (coverLetter !== null) {
        submitApplication(internshipId, coverLetter);
      }
    }

    async function submitApplication(internshipId, coverLetter) {
      try {
        const response = await fetch('/api/application/apply', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify({
            internship_id: internshipId,
            cover_letter: coverLetter
          })
        });

        const data = await response.json();

        if (response.ok) {
          alert('Application submitted successfully!');
        } else {
          alert(`Error: ${data.error}`);
        }
      } catch (err) {
        alert('Error submitting application');
      }
    }

    // ========== STEP 4: LOGOUT ==========
    function logout() {
      localStorage.clear();
      window.location.href = '/auth/login';
    }

    // ========== STEP 5: LOAD PAGE ==========
    loadInternships();
  </script>
</body>

</html>