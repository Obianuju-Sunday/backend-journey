<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Applications - Beacon</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html,
    body {
      height: 100%;
      display: flex;
      flex-direction: column;
      font-family: Arial;
      background-color: #efefef;
      color: #000000;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 40px 20px;
      flex: 1;
      width: 100%;
      display: flex;
      flex-direction: column;
    }

    h1 {
      color: #2a3f0f;
      margin-bottom: 30px;
    }

    .app-card {
      background: white;
      padding: 20px;
      margin-bottom: 15px;
      border-radius: 5px;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
      border-left: 4px solid #2a3f0f;
      width: 100%;
    }

    .app-header {
      display: flex;
      justify-content: space-between;
      align-items: start;
    }

    .app-title {
      font-size: 20px;
      font-weight: bold;
      color: #2a3f0f;
    }

    .app-date {
      color: #666;
      font-size: 12px;
    }

    .status {
      display: inline-block;
      padding: 8px 15px;
      border-radius: 20px;
      font-weight: 600;
      margin-top: 10px;
    }

    .status-pending {
      background-color: #fff3cd;
      color: #856404;
    }

    .status-accepted {
      background-color: #d4edda;
      color: #155724;
    }

    .status-rejected {
      background-color: #f8d7da;
      color: #721c24;
    }

    .empty {
      text-align: center;
      padding: 60px 20px;
      background: white;
      border-radius: 5px;
    }

    .empty h2 {
      color: #2a3f0f;
      margin-bottom: 10px;
    }

    .footer {
      background-color: #2a3f0f;
      color: #efefef;
      text-align: center;
      padding: 20px;
      margin-top: auto;
      /* ← THIS STICKS IT DOWN */
    }
  </style>
</head>

<body>
  <%- include('../layouts/navbar') %>

    <div class="container">

      <h2 style="margin: 0; font-size: 28px;">My Applications</h2>
      <br>
      <div id="applicationsContainer">
        <p>Loading your applications...</p>
      </div>
    </div>

    <%- include('../layouts/footer') %>

      <script>
        // const token = localStorage.getItem('token');
        // const user = JSON.parse(localStorage.getItem('user') || 'null');

        if (!token || user.role !== 'student') {
          window.location.href = '/auth/login';
        }

        async function loadMyApplications() {
          try {
            const response = await fetch('/api/application/my-applications', {
              headers: { 'Authorization': `Bearer ${token}` }
            });

            const data = await response.json();
            const container = document.getElementById('applicationsContainer');

            if (!data.applications || data.applications.length === 0) {
              container.innerHTML = `
            <div class="empty">
              <h2>No applications yet</h2>
              <p>Start applying to internships to track them here!</p>
            </div>
          `;
              return;
            }

            let html = '';
            data.applications.forEach(app => {
              const statusClass = `status-${app.status}`;

              html += `
    <div class="app-card">
      <div class="app-header">
        <div>
          <div class="app-title">${app.internship_title || 'Internship'}</div>
          <div class="app-date">${app.company_name}</div>
          <span class="status ${statusClass}">${app.status.toUpperCase()}</span>
        </div>
      </div>
    </div>
  `;
            });

            container.innerHTML = html;

          } catch (err) {
            console.error(err);
            document.getElementById('applicationsContainer').innerHTML = '<p style="color: red;">Error loading applications</p>';
          }
        }

        loadMyApplications();
      </script>
</body>

</html>