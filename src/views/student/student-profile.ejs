<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Profile - B E A C O N</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #efefef;
      color: #1a1a1a;
    }

    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 40px 20px;
    }

    h1 {
      color: #2a3f0f;
      margin-bottom: 30px;
      font-size: 32px;
    }

    .profile-card {
      background-color: white;
      padding: 40px;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      border-top: 4px solid #2a3f0f;
      margin-bottom: 30px;
    }

    .profile-info {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      margin-bottom: 30px;
    }

    .info-item {
      padding: 15px;
      background-color: #f9f9f9;
      border-radius: 5px;
      border-left: 3px solid #2a3f0f;
    }

    .info-item label {
      font-weight: 600;
      color: #2a3f0f;
      display: block;
      margin-bottom: 5px;
    }

    .info-item span {
      color: #666;
    }

    .edit-btn {
      background-color: #2a3f0f;
      color: #efefef;
      padding: 12px 25px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-weight: 600;
    }

    .edit-btn:hover {
      background-color: #1e3410;
    }

    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.5);
      z-index: 1000;
    }

    .modal.active {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .modal-content {
      background-color: white;
      padding: 40px;
      border-radius: 8px;
      max-width: 500px;
      width: 90%;
      border-top: 4px solid #2a3f0f;
    }

    .close-modal {
      position: absolute;
      top: 20px;
      right: 20px;
      font-size: 28px;
      cursor: pointer;
      color: #666;
    }

    .form-group {
      margin-bottom: 15px;
    }

    label {
      display: block;
      font-weight: 600;
      margin-bottom: 5px;
    }

    input,
    textarea {
      width: 100%;
      padding: 10px;
      border: 1px solid #e8e8e8;
      border-radius: 5px;
      font-family: inherit;
    }

    input:focus,
    textarea:focus {
      outline: none;
      border-color: #2a3f0f;
    }

    .btn-group {
      display: flex;
      gap: 10px;
      margin-top: 20px;
    }

    .btn {
      flex: 1;
      padding: 12px;
      border: none;
      border-radius: 5px;
      font-weight: 600;
      cursor: pointer;
    }

    .btn-submit {
      background-color: #2a3f0f;
      color: #efefef;
    }

    .btn-cancel {
      background-color: #e8e8e8;
      color: #1a1a1a;
    }

    .message {
      margin-top: 15px;
      padding: 10px;
      border-radius: 5px;
      text-align: center;
    }

    .success {
      background-color: #d4edda;
      color: #155724;
    }

    .error {
      background-color: #f8d7da;
      color: #721c24;
    }
  </style>
</head>

<body>
  <%- include('../layouts/navbar') %>

    <div class="container">
      <h1>My Profile</h1>

      <div class="profile-card">
        <div class="profile-info" id="profileInfo">
          <p>Loading profile...</p>
        </div>
        <button class="edit-btn" onclick="openEditModal()">Edit Profile</button>
      </div>

      <div id="skillsContainer" class="skills-card">
        <p>Loading skills...</p>
      </div>
    </div>

    <!-- Edit Profile Modal -->
    <div class="modal" id="editModal">
      <div class="modal-content">
        <span class="close-modal" onclick="closeEditModal()">&times;</span>
        <h2 style="color: #2a3f0f; margin-bottom: 20px;">Edit Profile</h2>

        <form id="editForm">
          <div class="form-group">
            <label>Full Name</label>
            <input type="text" id="editFullName" name="full_name">
          </div>

          <div class="form-group">
            <label>Program</label>
            <input type="text" id="editProgram" name="program">
          </div>

          <div class="form-group">
            <label>Year</label>
            <input type="number" id="editYear" name="year" min="1" max="6">
          </div>

          <div class="form-group">
            <label>Bio</label>
            <textarea id="editBio" name="bio" rows="3" placeholder="Tell us about yourself..."></textarea>
          </div>

          <div class="form-group">
            <label>Phone</label>
            <input type="tel" id="editPhone" name="phone">
          </div>

          <div class="form-group">
            <label>University</label>
            <input type="text" id="editUniversity" name="university">
          </div>

          <div class="form-group">
            <label>Location</label>
            <input type="text" id="editLocation" name="location">
          </div>

          <div class="form-group">
            <label>Portfolio Link</label>
            <input type="url" id="editPortfolio" name="portfolio_link" placeholder="https://...">
          </div>

          <div class="btn-group">
            <button type="submit" class="btn btn-submit">Save Changes</button>
            <button type="button" class="btn btn-cancel" onclick="closeEditModal()">Cancel</button>
          </div>
          <div id="editMessage"></div>
        </form>
      </div>
    </div>

    <%- include('../layouts/footer') %>

      <script>
        // const token = localStorage.getItem('token');
        // const user = JSON.parse(localStorage.getItem('user') || '{}');

        if (!token || user.role !== 'student') {
          window.location.href = '/auth/login';
        }

        async function loadProfile() {
          try {
            const response = await fetch('/api/users/student/profile', {
              headers: { 'Authorization': `Bearer ${token}` }
            });

            const data = await response.json();
            const container = document.getElementById('profileInfo');

            if (!response.ok) {
              container.innerHTML = '<p>Could not load profile.</p>';
              return;
            }

            const profile = data;
            container.innerHTML = '';

            // Helper function to create info item
            function createInfoItem(label, value, fullWidth = false) {
              const item = document.createElement('div');
              item.className = 'info-item';
              if (fullWidth) item.style.gridColumn = '1 / -1';

              const labelEl = document.createElement('label');
              labelEl.textContent = label;

              const valueEl = document.createElement('span');
              valueEl.textContent = value || 'Not set';

              item.appendChild(labelEl);
              item.appendChild(valueEl);
              return item;
            }

            // Add all profile items
            container.appendChild(createInfoItem('Full Name', profile.full_name));
            container.appendChild(createInfoItem('Email', user.email));
            container.appendChild(createInfoItem('Program', profile.program));
            container.appendChild(createInfoItem('Year', profile.year));
            container.appendChild(createInfoItem('University', profile.university));
            container.appendChild(createInfoItem('Location', profile.location));
            container.appendChild(createInfoItem('Phone', profile.phone, true));
            container.appendChild(createInfoItem('Bio', profile.bio, true));

            // Portfolio link
            const portfolioItem = document.createElement('div');
            portfolioItem.className = 'info-item';
            portfolioItem.style.gridColumn = '1 / -1';

            const portfolioLabel = document.createElement('label');
            portfolioLabel.textContent = 'Portfolio';
            portfolioItem.appendChild(portfolioLabel);

            if (profile.portfolio_link) {
              const link = document.createElement('a');
              link.textContent = profile.portfolio_link;
              link.href = profile.portfolio_link;
              link.target = '_blank';
              link.rel = 'noopener noreferrer';
              portfolioItem.appendChild(link);
            } else {
              const span = document.createElement('span');
              span.textContent = 'Not set';
              portfolioItem.appendChild(span);
            }
            container.appendChild(portfolioItem);

            // Fill edit form with ALL fields
            document.getElementById('editFullName').value = profile.full_name || '';
            document.getElementById('editProgram').value = profile.program || '';
            document.getElementById('editYear').value = profile.year || '';
            document.getElementById('editBio').value = profile.bio || '';
            document.getElementById('editPhone').value = profile.phone || '';
            document.getElementById('editUniversity').value = profile.university || '';
            document.getElementById('editLocation').value = profile.location || '';
            document.getElementById('editPortfolio').value = profile.portfolio_link || '';

            loadStudentSkills();

          } catch (err) {
            console.error(err);
            document.getElementById('profileInfo').innerHTML = '<p>Could not load profile.</p>';
          }
        }

        async function loadStudentSkills() {
          try {
            const response = await fetch('/api/skills/my-skills', {
              headers: { 'Authorization': `Bearer ${token}` }
            });

            const data = await response.json();
            const skillsContainer = document.getElementById('skillsContainer');
            skillsContainer.innerHTML = '';

            if (!data.skills || data.skills.length === 0) {
              const skillItem = document.createElement('div');
              skillItem.className = 'info-item';
              skillItem.style.gridColumn = '1 / -1';

              const label = document.createElement('label');
              label.textContent = 'Skills';

              const message = document.createElement('div');
              message.style.color = '#999';
              message.textContent = 'No skills added yet. ';

              const link = document.createElement('a');
              link.href = '/student/skill-profile';
              link.textContent = 'Add skills';
              link.style.color = '#2a3f0f';
              link.style.fontWeight = 'bold';

              message.appendChild(link);
              skillItem.appendChild(label);
              skillItem.appendChild(message);
              skillsContainer.appendChild(skillItem);
              return;
            }

            const skillItem = document.createElement('div');
            skillItem.className = 'info-item';
            skillItem.style.gridColumn = '1 / -1';
            skillItem.style.borderTop = '4px solid #2a3f0f';

            const label = document.createElement('label');
            label.textContent = 'Skills';

            const skillsWrapper = document.createElement('div');
            skillsWrapper.style.display = 'flex';
            skillsWrapper.style.flexWrap = 'wrap';
            skillsWrapper.style.gap = '10px';

            data.skills.forEach(skill => {
              const skillBadge = document.createElement('span');
              skillBadge.style.backgroundColor = '#2a3f0f';
              skillBadge.style.color = '#efefef';
              skillBadge.style.padding = '8px 12px';
              skillBadge.style.borderRadius = '20px';
              skillBadge.style.fontSize = '12px';
              skillBadge.style.fontWeight = '600';
              skillBadge.textContent = `${skill.skill_name} • ${skill.proficiency}`;
              skillsWrapper.appendChild(skillBadge);
            });

            skillItem.appendChild(label);
            skillItem.appendChild(skillsWrapper);
            skillsContainer.appendChild(skillItem);

          } catch (err) {
            console.error(err);
          }
        }

        function openEditModal() {
          document.getElementById('editModal').classList.add('active');
        }

        function closeEditModal() {
          document.getElementById('editModal').classList.remove('active');
          document.getElementById('editMessage').innerHTML = '';
        }

        document.getElementById('editForm').addEventListener('submit', async (e) => {
          e.preventDefault();

          const formData = new FormData(e.target);
          const data = Object.fromEntries(formData);

          try {
            const response = await fetch('/api/users/student/profile', {
              method: 'PATCH',
              headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
              },
              body: JSON.stringify(data)
            });

            const result = await response.json();
            const messageDiv = document.getElementById('editMessage');

            if (response.ok) {
              messageDiv.className = 'message success';
              messageDiv.textContent = 'Profile updated successfully!';

              setTimeout(() => {
                closeEditModal();
                loadProfile();
              }, 1500);

            } else {
              messageDiv.className = 'message error';
              messageDiv.textContent = result.error || 'Failed to update profile';
            }

          } catch (err) {
            console.error(err);
            const messageDiv = document.getElementById('editMessage');
            messageDiv.className = 'message error';
            messageDiv.textContent = 'Error updating profile';
          }
        });

        loadProfile();
      </script>
</body>

</html>