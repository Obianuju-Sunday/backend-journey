<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Internships - <%= orgName %></title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            padding: 20px;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 8px;
            padding: 30px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #007bff;
            padding-bottom: 20px;
        }
        
        .header h1 {
            font-size: 28px;
            color: #333;
        }
        
        .header-info {
            text-align: right;
            font-size: 14px;
            color: #666;
        }
        
        .header-info p {
            margin: 5px 0;
        }
        
        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 14px;
            text-decoration: none;
            display: inline-block;
            margin-right: 10px;
            transition: background 0.3s;
        }
        
        .btn-primary {
            background: #007bff;
            color: white;
        }
        
        .btn-primary:hover {
            background: #0056b3;
        }
        
        .btn-secondary {
            background: #6c757d;
            color: white;
        }
        
        .btn-secondary:hover {
            background: #545b62;
        }
        
        .btn-danger {
            background: #dc3545;
            color: white;
        }
        
        .btn-danger:hover {
            background: #c82333;
        }
        
        .btn-success {
            background: #28a745;
            color: white;
        }
        
        .btn-success:hover {
            background: #218838;
        }
        
        .action-bar {
            margin-bottom: 25px;
            display: flex;
            gap: 10px;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        
        table thead {
            background-color: #f8f9fa;
            border-bottom: 2px solid #dee2e6;
        }
        
        table th {
            padding: 12px;
            text-align: left;
            font-weight: 600;
            color: #333;
        }
        
        table td {
            padding: 12px;
            border-bottom: 1px solid #dee2e6;
            color: #666;
        }
        
        table tbody tr:hover {
            background-color: #f9f9f9;
        }
        
        .status-badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }
        
        .status-active {
            background-color: #d4edda;
            color: #155724;
        }
        
        .status-inactive {
            background-color: #f8d7da;
            color: #721c24;
        }
        
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #999;
        }
        
        .empty-state h2 {
            font-size: 22px;
            margin-bottom: 10px;
            color: #666;
        }
        
        .empty-state p {
            margin-bottom: 20px;
        }
        
        .actions {
            display: flex;
            gap: 8px;
        }
        
        .actions form {
            display: inline;
        }
        
        .actions button {
            margin: 0;
        }
        
        .nav-top {
            background-color: #007bff;
            color: white;
            padding: 15px 20px;
            border-radius: 5px;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .nav-top a {
            color: white;
            text-decoration: none;
            margin-left: 20px;
            font-size: 14px;
        }
        
        .nav-top a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <!-- <div class="nav-top">
        <strong><%= orgName %></strong>
        <div>
            <a href="/org/dashboard">Dashboard</a>
            <a href="/auth/logout">Logout</a>
        </div>
    </div> -->
    
    <div class="container">
        <!-- Header -->
        <div class="header">
            <div>
                <h1>My Internships</h1>
            </div>
            <div class="header-info">
                <p><strong>Organization:</strong> <%= orgName %></p>
                <p><strong>Total Internships:</strong> <%= internships ? internships.length : 0 %></p>
            </div>
        </div>
        
        <!-- Action Bar -->
        <div class="action-bar">
            <a href="/internship/org" class="btn btn-primary">+ Post New Internship</a>
        </div>
        
        <!-- Internships Table -->
        <% if (internships && internships.length > 0) { %>
            <table>
                <thead>
                    <tr>
                        <th>Internship Title</th>
                        <th>Location</th>
                        <th>Date Posted</th>
                        <th>Applicants</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% internships.forEach(internship => { %>
                        <tr>
                            <td><strong><%= internship.title %></strong></td>
                            <td><%= internship.location %></td>
                            <td><%= new Date(internship.createdAt).toLocaleDateString() %></td>
                            <td><strong><%= internship.applicantCount || 0 %></strong></td>
                            <td>
                                <span class="status-badge <%= internship.isActive ? 'status-active' : 'status-inactive' %>">
                                    <%= internship.isActive ? 'Active' : 'Inactive' %>
                                </span>
                            </td>
                            <td>
                                <div class="actions">
                                    <a href="/org/internships/<%= internship.id %>/applications" class="btn btn-success">View Applications</a>
                                    <a href="/org/internships/<%= internship.id %>/edit" class="btn btn-secondary">Edit</a>
                                    <form method="POST" action="/org/internships/<%= internship.id %>/delete">
                                        <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this internship?')">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        <% } else { %>
            <div class="empty-state">
                <h2>No Internships Posted Yet</h2>
                <p>Start by posting your first internship opportunity</p>
                <a href="/org/internships/new" class="btn btn-primary">+ Post New Internship</a>
            </div>
        <% } %>
    </div>
</body>
</html>