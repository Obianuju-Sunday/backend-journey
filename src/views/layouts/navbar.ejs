<nav style="background-color: #2a3f0f; padding: 20px 50px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
  <a href="/" style="color: #efefef; font-size: 24px; font-weight: bold; text-decoration: none;">B E A C O N</a>
  
  <div style="display: flex; gap: 20px; align-items: center;" id="navbarContent">
    <!-- Content will be filled by JavaScript -->
  </div>
</nav>

<script>
  const token = localStorage.getItem('token');
  const user = JSON.parse(localStorage.getItem('user') || 'null');
  const navbarContent = document.getElementById('navbarContent');
  const currentPath = window.location.pathname; // Get current page

  if (token && user) {
    if (user.role === 'student') {
      // Create links array
      const links = [
        { href: '/student/browse-internship', text: 'Browse' },
        { href: '/student/skill-profile', text: 'My Skills' },
        { href: '/student/my-applications', text: 'Applications' },
        { href: '/student/student-profile', text: 'Profile' }
      ];

      // Build navbar but skip the current page
      let html = '';
      links.forEach(link => {
        if (currentPath !== link.href) {
          html += `<a href="${link.href}" style="color: #efefef; text-decoration: none; font-weight: 600;">${link.text}</a>`;
        }
      });
      html += `<button onclick="logout()" style="background-color: #c41e3a; color: white; border: none; padding: 8px 15px; border-radius: 5px; cursor: pointer; font-weight: 600;">Logout</button>`;
      navbarContent.innerHTML = html;

    } else if (user.role === 'organisation') {
      const links = [
        { href: '/org/dashboard', text: 'Dashboard' },
        { href: '/org/internship-applications', text: 'Applications' },
        { href: '/org/profile', text: 'Profile' }
      ];

      let html = '';
      links.forEach(link => {
        if (currentPath !== link.href) {
          html += `<a href="${link.href}" style="color: #efefef; text-decoration: none; font-weight: 600;">${link.text}</a>`;
        }
      });
      html += `<button onclick="logout()" style="background-color: #c41e3a; color: white; border: none; padding: 8px 15px; border-radius: 5px; cursor: pointer; font-weight: 600;">Logout</button>`;
      navbarContent.innerHTML = html;
    }
  } else {
    navbarContent.innerHTML = `
      <a href="/auth/login" style="color: #efefef; text-decoration: none; font-weight: 600;">Login</a>
      <a href="/auth/register-student" style="color: #efefef; text-decoration: none; font-weight: 600;">Register Student</a>
      <a href="/auth/register-organisation" style="color: #efefef; text-decoration: none; font-weight: 600;">Register Org</a>
    `;
  }

  function logout() {
    localStorage.clear();
    window.location.href = '/';
  }
</script>